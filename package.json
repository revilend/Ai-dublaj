{
  "name": "voxstudio-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Build pipeline for the VoxStudio studio UI: compiled Tailwind CSS + vendored browser libraries.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/tailwind.css -o ./app/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/tailwind.css -o ./app/static/css/tailwind.css --watch",
    "vendor": "node ./scripts/vendor-assets.mjs",
    "build:pages": "node ./scripts/build-pages.mjs",
    "build": "npm run build:css && npm run vendor"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "tailwindcss": "^3.4.17"
  }
}
